import React, { useState, useEffect, useRef } from 'react';

export default function App() {
  const [navOpen, setNavOpen] = useState(false);
  const [showScrollTop, setShowScrollTop] = useState(false);
  const [slideIndex, setSlideIndex] = useState(0);
  const [contactSubmitted, setContactSubmitted] = useState(false);
  const [contactName, setContactName] = useState('');

  const galleryImages = [
    { src: '/image1.jpg', alt: 'gallery1' },
    { src: '/image2.jpg', alt: 'gallery2' },
    { src: '/image3.jpg', alt: 'gallery3' },
    { src: '/image4.jpg', alt: 'gallery4' },
    { src: '/image5.jpg', alt: 'gallery5' },
    { src: '/image6.jpg', alt: 'gallery6' },
  ];

  const canvasRef = useRef<HTMLCanvasElement | null>(null);

  // Canvas glitter particles effect (identical to original code)
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let W = (canvas.width = window.innerWidth);
    let H = (canvas.height = window.innerHeight);

    const handleResize = () => {
      if (!canvas) return;
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    };
    window.addEventListener('resize', handleResize);

    const rand = (min: number, max: number) => Math.random() * (max - min) + min;
    const particles: Array<{ x: number; y: number; r: number; a: number; vy: number }> = [];

    for (let i = 0; i < 80; i++) {
      particles.push({
        x: rand(0, W),
        y: rand(0, H),
        r: rand(0.6, 2.6),
        a: rand(0.1, 0.9),
        vy: rand(0.1, 0.6),
      });
    }

    let animationFrameId: number;

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      for (const p of particles) {
        ctx.beginPath();
        ctx.globalAlpha = p.a * 0.9;
        ctx.fillStyle = 'rgba(255,255,255,1)';
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
        p.y -= p.vy;
        p.x += Math.sin(p.y * 0.01 + p.r);
        if (p.y < -10) {
          p.y = H + 10;
          p.x = rand(0, W);
        }
      }
      animationFrameId = requestAnimationFrame(draw);
    };

    draw();

    return () => {
      window.removeEventListener('resize', handleResize);
      cancelAnimationFrame(animationFrameId);
    };
  }, []);

  // Automatic slideshow interval (4 seconds, identical to original code)
  useEffect(() => {
    const interval = setInterval(() => {
      setSlideIndex((prev) => (prev + 1) % galleryImages.length);
    }, 4000);
    return () => clearInterval(interval);
  }, [galleryImages.length]);

  // Scroll to top button visibility check
  useEffect(() => {
    const handleScroll = () => {
      if (window.scrollY > 300) {
        setShowScrollTop(true);
      } else {
        setShowScrollTop(false);
      }
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  const handlePrevSlide = () => {
    setSlideIndex((prev) => (prev === 0 ? galleryImages.length - 1 : prev - 1));
  };

  const handleNextSlide = () => {
    setSlideIndex((prev) => (prev + 1) % galleryImages.length);
  };

  const scrollToSection = (id: string) => {
    setNavOpen(false);
    const element = document.getElementById(id);
    if (element) {
      element.scrollIntoView({ behavior: 'smooth' });
    }
  };

  const scrollToTop = () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const handleContactSubmit = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    const form = e.currentTarget;
    const nameInput = form.querySelector('input[type="text"]') as HTMLInputElement;
    const submittedName = nameInput?.value || 'Friend';
    setContactName(submittedName);
    setContactSubmitted(true);
    form.reset();
  };

  return (
    <div className="relative w-full bg-white text-[#0f0f10] overflow-x-hidden selection:bg-[#ff4d9e] selection:text-white">
      {/* ========================================================================= */}
      {/* 1. Responsive Navigation Bar */}
      {/* ========================================================================= */}
      <nav className="fixed top-0 left-0 w-full bg-black/45 backdrop-blur-[2px] z-[1000] py-3 transition-colors duration-300">
        <div className="max-w-[1200px] mx-auto px-6 sm:px-8 flex items-center justify-between">
          <div className="font-playfair text-[22px] text-white font-bold tracking-normal">
            LoveDeGlam
          </div>

          {/* Hamburger Button for Mobile */}
          <button
            onClick={() => setNavOpen(!navOpen)}
            className="md:hidden flex flex-col gap-[5px] cursor-pointer p-1 z-50 focus:outline-none"
            aria-label="Toggle navigation"
          >
            <span
              className={`w-[26px] h-[3px] bg-white rounded-full transition-transform duration-300 ${
                navOpen ? 'rotate-45 translate-y-[8px]' : ''
              }`}
            ></span>
            <span
              className={`w-[26px] h-[3px] bg-white rounded-full transition-opacity duration-300 ${
                navOpen ? 'opacity-0' : ''
              }`}
            ></span>
            <span
              className={`w-[26px] h-[3px] bg-white rounded-full transition-transform duration-300 ${
                navOpen ? '-rotate-45 -translate-y-[8px]' : ''
              }`}
            ></span>
          </button>

          {/* Nav Links */}
          <ul
            className={`list-none flex gap-7 m-0 p-0 transition-all duration-300 ${
              navOpen
                ? 'flex flex-col items-center gap-5 py-6 absolute top-[56px] left-0 w-full bg-black/90 shadow-2xl md:static md:flex-row md:w-auto md:bg-transparent md:p-0'
                : 'hidden md:flex'
            }`}
          >
            <li>
              <a
                href="#"
                onClick={(e) => {
                  e.preventDefault();
                  scrollToTop();
                  setNavOpen(false);
                }}
                className="text-white font-medium text-[15px] hover:text-[#ff7ab6] transition-colors"
              >
                Home
              </a>
            </li>
            <li>
              <a
                href="#services"
                onClick={(e) => {
                  e.preventDefault();
                  scrollToSection('services');
                }}
                className="text-white font-medium text-[15px] hover:text-[#ff7ab6] transition-colors"
              >
                Services
              </a>
            </li>
            <li>
              <a
                href="#gallery"
                onClick={(e) => {
                  e.preventDefault();
                  scrollToSection('gallery');
                }}
                className="text-white font-medium text-[15px] hover:text-[#ff7ab6] transition-colors"
              >
                Gallery
              </a>
            </li>
            <li>
              <a
                href="#videos"
                onClick={(e) => {
                  e.preventDefault();
                  scrollToSection('videos');
                }}
                className="text-white font-medium text-[15px] hover:text-[#ff7ab6] transition-colors"
              >
                Videos
              </a>
            </li>
            <li>
              <a
                href="#testimonials"
                onClick={(e) => {
                  e.preventDefault();
                  scrollToSection('testimonials');
                }}
                className="text-white font-medium text-[15px] hover:text-[#ff7ab6] transition-colors"
              >
                Testimonials
              </a>
            </li>
            <li>
              <a
                href="#contact"
                onClick={(e) => {
                  e.preventDefault();
                  scrollToSection('contact');
                }}
                className="text-white font-medium text-[15px] hover:text-[#ff7ab6] transition-colors"
              >
                Contact
              </a>
            </li>
          </ul>
        </div>
      </nav>

      {/* Glitter Particle Canvas */}
      <canvas
        ref={canvasRef}
        id="glitter"
        className="absolute inset-0 z-0 pointer-events-none w-full h-full"
      />

      {/* ========================================================================= */}
      {/* 2. Hero Section */}
      {/* ========================================================================= */}
      <header className="hero">
        {/* Hero Left Content */}
        <div className="hero-inner wrap">
          {/* Logo Card */}
          <div className="logo card">
            <img
              src="/logo.jpg"
              alt="LoveDeGlam logo"
            />
            <div>
              <h1>LoveDeGlam</h1>
              <div style={{ fontSize: '12px', color: 'rgba(255,255,255,0.9)' }}>
                Luxury · Confidence · Transformation
              </div>
            </div>
          </div>

          <h2 className="lead fade-up">
            Glam that tells your story.
          </h2>

          <p className="lead-desc fade-up">
            Professional makeup, premium frontal installation and bespoke hair revamping —
            handcrafted by experienced stylists. Book a consultation, get a trial, and step out
            glowing.
          </p>

          <div className="actions fade-up">
            <button
              onClick={() => scrollToSection('contact')}
              className="btn primary"
              id="bookNow"
            >
              Book a Consultation
            </button>
            <button
              onClick={() => scrollToSection('services')}
              className="btn ghost"
              id="viewMore"
            >
              Our Services
            </button>
          </div>

          <div style={{ height: '24px' }}></div>

          <div style={{ color: 'rgba(255,255,255,0.9)', fontSize: '13px', display: 'flex', gap: '20px', alignItems: 'center', flexWrap: 'wrap' }}>
            <div>⭐ 4.9 (2.3k reviews)</div>
            <div>•</div>
            <div>Professional stylists</div>
            <div>•</div>
            <div>Premium products</div>
          </div>
        </div>

        {/* Hero Right Showcase Card */}
        <div className="showcase wrap">
          <div className="card fade-up">
            <div className="showcase-inner">
              <div className="hero-img">
                <img
                  src="/background.jpg"
                  alt="LoveDeGlam showcase"
                />
              </div>
            </div>
          </div>
        </div>

        {/* Decorative SVG Wave */}
        <svg
          className="waves"
          viewBox="0 0 1200 200"
          preserveAspectRatio="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <linearGradient id="g1" x1="0" x2="1">
              <stop offset="0%" stopColor="var(--pink-1)" stopOpacity="0.5" />
              <stop offset="100%" stopColor="var(--pink-2)" stopOpacity="0.45" />
            </linearGradient>
          </defs>
          <path
            d="M0,120 C200,180 400,40 600,80 C800,120 1000,20 1200,80 L1200,200 L0,200 Z"
            fill="url(#g1)"
          ></path>
        </svg>
      </header>

      {/* ========================================================================= */}
      {/* 3. Main Content Area */}
      {/* ========================================================================= */}
      <main>
        {/* ======================================================================= */}
        {/* Services Section */}
        {/* ======================================================================= */}
        <section
          id="services"
          className="relative text-center py-8"
          style={{
            background: 'linear-gradient(180deg, rgba(255,255,255,0.02), #ff4d9e)',
          }}
        >
          <div className="max-w-[1200px] mx-auto px-6 sm:px-8">
            <h2 className="mt-0 font-playfair text-[32px] sm:text-[36px] font-bold text-white mb-6">
              Our Signature Services
            </h2>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[22px] my-8">
              {/* Card 1: Makeup Artistry & Frontal Installation */}
              <article
                className="p-7 rounded-[16px] transition-all duration-360 text-left shadow-[0_8px_20px_rgba(15,15,16,0.04)] hover:-translate-y-2.5 hover:shadow-[0_22px_40px_rgba(15,15,16,0.08)] group"
                style={{
                  background: 'linear-gradient(180deg, rgba(8, 8, 8, 0.02), #ff4d9e)',
                  boxShadow: '#ff2e84',
                }}
              >
                <h3 className="m-0 mb-2 text-[20px] font-bold text-[#0f0f10] group-hover:text-white transition-colors">
                  All Kinds (Makeup Artistry)
                </h3>
                <p className="text-[14px] text-[#333] group-hover:text-white transition-colors mb-4">
                  Bridal, editorial, photoshoots, and everyday glam. We use premium, skin-safe
                  brands and tailor looks to your skin tone and style.
                </p>
                <h3 className="m-0 mb-2 text-[20px] font-bold text-[#0f0f10] group-hover:text-white transition-colors">
                  Frontal Installation
                </h3>
                <p className="text-[14px] text-[#333] group-hover:text-white transition-colors">
                  Seamless frontal installs with natural hairlines. Consultation, custom
                  color-matching, and maintenance guidance included.
                </p>
              </article>

              {/* Card 2: Hair Revamping */}
              <article
                className="p-7 rounded-[16px] transition-all duration-360 text-left shadow-[0_8px_20px_rgba(15,15,16,0.04)] hover:-translate-y-2.5 hover:shadow-[0_22px_40px_rgba(15,15,16,0.08)] group"
                style={{
                  background: 'linear-gradient(180deg, rgba(8, 8, 8, 0.02), #ff4d9e)',
                  boxShadow: '#ff2e84',
                }}
              >
                <h3 className="m-0 mb-2 text-[20px] font-bold text-[#0f0f10] group-hover:text-white transition-colors">
                  Hair Revamping
                </h3>
                <ul className="list-disc pl-5 mb-4 text-[14px] text-[#222] group-hover:text-white transition-colors space-y-1">
                  <li>Custom wig making</li>
                  <li>Premium revamping</li>
                  <li>premium silk infusion service</li>
                  <li>curl definition</li>
                  <li>Wig styling</li>
                </ul>
                <p className="text-[14px] text-[#333] group-hover:text-white transition-colors">
                  Glueless and customization Cutting-edge restyles, extensions, color refresh, and
                  healthy hair treatments to bring your vision to life.
                </p>
              </article>

              {/* Card 3: Training (Hair-Installation) */}
              <article
                className="p-7 rounded-[16px] transition-all duration-360 text-left shadow-[0_8px_20px_rgba(15,15,16,0.04)] hover:-translate-y-2.5 hover:shadow-[0_22px_40px_rgba(15,15,16,0.08)] group"
                style={{
                  background: 'linear-gradient(180deg, rgba(8, 8, 8, 0.02), #ff4d9e)',
                  boxShadow: '#ff2e84',
                }}
              >
                <h3 className="m-0 mb-2 text-[20px] font-bold text-[#0f0f10] group-hover:text-white transition-colors">
                  Training <br />(Hair-Installation)
                </h3>
                <ul className="list-disc pl-5 text-[14px] text-[#222] group-hover:text-white transition-colors space-y-1">
                  <li>Glued &amp; Glueless Frontal Wig Installation</li>
                  <li>Frontal Ponytails &amp; Sew-ins</li>
                  <li>5x5, 6x6, 7x6 Closures</li>
                  <li>360 &amp; Double Frontal Wigs</li>
                  <li>Natural &amp; Relaxed Hair Ponytails</li>
                  <li>Braided Frontal Wigs</li>
                  <li>Premium Wig Revamping &amp; Styling All Hair Types</li>
                </ul>
              </article>

              {/* Card 4: Training (Makeup) */}
              <article
                className="p-7 rounded-[16px] transition-all duration-360 text-left shadow-[0_8px_20px_rgba(15,15,16,0.04)] hover:-translate-y-2.5 hover:shadow-[0_22px_40px_rgba(15,15,16,0.08)] group"
                style={{
                  background: 'linear-gradient(180deg, rgba(8, 8, 8, 0.02), #ff4d9e)',
                  boxShadow: '#ff2e84',
                }}
              >
                <h3 className="m-0 mb-2 text-[20px] font-bold text-[#0f0f10] group-hover:text-white transition-colors">
                  Training <br />(Makeup)
                </h3>
                <ul className="list-disc pl-5 text-[14px] text-[#222] group-hover:text-white transition-colors space-y-1">
                  <li>flawless long wear bridal makeup on different skin types and tones.</li>
                  <li>
                    Different eyeshadow techniques (How to switch from simple to bold
                    eyeshadows)
                  </li>
                  <li>Skin prep on different skin types</li>
                  <li>Different products recommendations &amp; awareness</li>
                  <li>Phone editing (Picture and Video)</li>
                  <li>Light set up</li>
                  <li>Deep Discussions on the business</li>
                </ul>
              </article>
            </div>
          </div>
        </section>

        {/* ======================================================================= */}
        {/* Gallery Section with Exact Slider */}
        {/* ======================================================================= */}
        <section
          id="gallery"
          aria-label="Gallery"
          className="relative py-[80px] px-5 text-center -top-8"
          style={{
            background: 'linear-gradient(0deg, rgba(153, 51, 107, 0.02), #ff4d9e)',
          }}
        >
          <div className="max-w-[1200px] mx-auto">
            <h2 className="font-playfair text-[34px] font-bold text-white mb-6">Gallery</h2>

            {/* Slider Container */}
            <div className="relative max-w-[1000px] mx-auto overflow-hidden rounded-[10px] shadow-2xl">
              {/* Prev Button */}
              <button
                onClick={handlePrevSlide}
                className="absolute left-[10px] top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black text-white border-none text-[30px] px-[15px] py-[10px] cursor-pointer rounded-[5px] z-20 transition-colors"
                aria-label="Previous slide"
              >
                &#10094;
              </button>

              {/* Slides Track */}
              <div
                className="flex transition-transform duration-500 ease-out"
                style={{ transform: `translateX(-${slideIndex * 100}%)` }}
              >
                {galleryImages.map((img, i) => (
                  <img
                    key={i}
                    src={img.src}
                    alt={img.alt}
                    className="w-full max-w-[1000px] h-[400px] object-cover rounded-[10px] shrink-0"
