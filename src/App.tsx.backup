              </div>

              {/* Next Button */}
              <button
                onClick={handleNextSlide}
                className="absolute right-[10px] top-1/2 -translate-y-1/2 bg-black/60 hover:bg-black text-white border-none text-[30px] px-[15px] py-[10px] cursor-pointer rounded-[5px] z-20 transition-colors"
                aria-label="Next slide"
              >
                &#10095;
              </button>
            </div>
          </div>
        </section>

        {/* ======================================================================= */}
        {/* Video Section */}
        {/* ======================================================================= */}
        <section id="videos" className="relative py-[80px] bg-[#f9fafb] -top-32">
          <div className="max-w-[1200px] mx-auto px-6 sm:px-8">
