            className="w-[50px] h-[50px] rounded-full flex items-center justify-center text-[22px] text-white no-underline transition-all duration-300 shadow-[0_4px_14px_rgba(0,0,0,0.25)] hover:scale-110 hover:-translate-y-[5px] hover:shadow-[0_6px_20px_rgba(0,0,0,0.35)] bg-[#25D366]"
