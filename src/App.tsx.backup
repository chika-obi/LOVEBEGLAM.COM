        {/* ======================================================================= */}
        {/* Floating Social Contact Bar */}
        {/* ======================================================================= */}
        <div className="fixed bottom-[60px] right-6 sm:right-10 flex flex-col gap-[14px] z-[999] max-[600px]:flex-row max-[600px]:bottom-5 max-[600px]:left-1/2 max-[600px]:-translate-x-1/2 max-[600px]:right-auto max-[600px]:gap-4">
          <a
            href="mailto:lovedeglam@gmail.com"
            className="w-[50px] h-[50px] rounded-full flex items-center justify-center text-[22px] text-white no-underline transition-all duration-300 shadow-[0_4px_14px_rgba(0,0,0,0.25)] hover:scale-110 hover:-translate-y-[5px] hover:shadow-[0_6px_20px_rgba(0,0,0,0.35)] bg-[#D44638]"
