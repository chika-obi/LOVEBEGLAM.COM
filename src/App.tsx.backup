            className="w-[50px] h-[50px] rounded-full flex items-center justify-center text-[22px] text-white no-underline transition-all duration-300 shadow-[0_4px_14px_rgba(0,0,0,0.25)] hover:scale-110 hover:-translate-y-[5px] hover:shadow-[0_6px_20px_rgba(0,0,0,0.35)] bg-[#FF0000]"
            title="YouTube"
          >
            <i className="fa-brands fa-youtube"></i>
          </a>

          <a
            href="https://www.facebook.com/share/1A4atmAeEw/?mibextid=wwXIfr"
            target="_blank"
            rel="noopener noreferrer"
            className="w-[50px] h-[50px] rounded-full flex items-center justify-center text-[22px] text-white no-underline transition-all duration-300 shadow-[0_4px_14px_rgba(0,0,0,0.25)] hover:scale-110 hover:-translate-y-[5px] hover:shadow-[0_6px_20px_rgba(0,0,0,0.35)] bg-[#1877F2]"
            title="Facebook"
          >
