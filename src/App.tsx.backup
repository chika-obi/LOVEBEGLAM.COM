          </a>

          <a
            href="https://www.tiktok.com/@love.de.glam?_t=ZS-90MDaXhYsc5&_r=1"
            target="_blank"
            rel="noopener noreferrer"
            className="w-[50px] h-[50px] rounded-full flex items-center justify-center text-[22px] text-white no-underline transition-all duration-300 shadow-[0_4px_14px_rgba(0,0,0,0.25)] hover:scale-110 hover:-translate-y-[5px] hover:shadow-[0_6px_20px_rgba(0,0,0,0.35)] bg-[#000000]"
            title="TikTok"
          >
            <i className="fa-brands fa-tiktok"></i>
          </a>

          <a
            href="https://www.instagram.com/lovedeglam?igsh=YWYzYmcydDJyZGg0&utm_source=qr"
            target="_blank"
            rel="noopener noreferrer"
            className="w-[50px] h-[50px] rounded-full flex items-center justify-center text-[22px] text-white no-underline transition-all duration-300 shadow-[0_4px_14px_rgba(0,0,0,0.25)] hover:scale-110 hover:-translate-y-[5px] hover:shadow-[0_6px_20px_rgba(0,0,0,0.35)]"
            style={{
              background: 'linear-gradient(45deg, #F58529, #DD2A7B, #8134AF, #515BD4)',
            }}
            title="Instagram"
          >
            <i className="fa-brands fa-instagram"></i>
          </a>
        </div>

        {/* ======================================================================= */}
        {/* Contact Section */}
        {/* ======================================================================= */}
        <section id="contact" className="relative -top-40 bg-[#f9fafb] py-16">
          <div className="max-w-[1100px] mx-auto px-5">
            <div className="text-center mb-[50px]">
              <h2 className="font-playfair text-[34px] mb-[10px] font-bold text-[#0f0f10]">
                Get In Touch
              </h2>
              <p className="text-[#666] max-w-[600px] mx-auto leading-[1.6] text-[15px]">
                We'd love to hear from you. Whether you're booking a session, asking questions, or
                requesting a consultation — send us a message.
              </p>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-[350px_1fr] gap-10">
              {/* CONTACT DETAILS */}
              <div className="flex flex-col gap-[18px]">
                <div className="flex items-center gap-[15px] bg-pink-200 p-[18px] rounded-[12px] shadow-[0_5px_20px_rgba(0,0,0,0.05)] transition-transform duration-300 hover:-translate-y-1">
                  <span className="text-[22px]">📍</span>
                  <div>
                    <h4 className="text-[15px] font-bold mb-1 text-[#0f0f10]">Location</h4>
                    <p className="text-[14px] text-[#555] m-0">
                      No 11 Ebony Road, Oroazi, Port Harcourt, Rivers State, Nigeria
                    </p>
                  </div>
                </div>

                <div className="flex items-center gap-[15px] bg-pink-200 p-[18px] rounded-[12px] shadow-[0_5px_20px_rgba(0,0,0,0.05)] transition-transform duration-300 hover:-translate-y-1">
                  <span className="text-[22px]">📞</span>
                  <div>
                    <h4 className="text-[15px] font-bold mb-1 text-[#0f0f10]">Phone</h4>
                    <p className="text-[14px] text-[#555] m-0 leading-relaxed">
                      +234 907 373 3455 <br />
                      +234 916 264 8527 <br />
                      +234 809 529 4480
                    </p>
                  </div>
                </div>

                <div className="flex items-center gap-[15px] bg-pink-200 p-[18px] rounded-[12px] shadow-[0_5px_20px_rgba(0,0,0,0.05)] transition-transform duration-300 hover:-translate-y-1">
                  <span className="text-[22px]">✉</span>
                  <div>
                    <h4 className="text-[15px] font-bold mb-1 text-[#0f0f10]">Email</h4>
                    <p className="text-[14px] text-[#555] m-0">lovedeglam@gmail.com</p>
                  </div>
                </div>

                <div className="flex items-center gap-[15px] bg-pink-200 p-[18px] rounded-[12px] shadow-[0_5px_20px_rgba(0,0,0,0.05)] transition-transform duration-300 hover:-translate-y-1">
                  <span className="text-[22px]">⏰</span>
                  <div>
                    <h4 className="text-[15px] font-bold mb-1 text-[#0f0f10]">Working Hours</h4>
                    <p className="text-[14px] text-[#555] m-0">Mon – Sat : 9AM – 6PM</p>
                  </div>
                </div>
              </div>

              {/* CONTACT FORM */}
              <form
                id="contactForm"
                onSubmit={handleContactSubmit}
                className="bg-pink-200 p-7 sm:p-[35px] rounded-[14px] shadow-[0_10px_30px_rgba(0,0,0,0.08)] flex flex-col"
              >
                {contactSubmitted && (
                  <div className="mb-4 p-4 rounded-lg bg-white/80 text-[#0f0f10] text-sm font-semibold border border-pink-400">
                    Thanks, {contactName}! We received your request and will contact you soon.
                  </div>
                )}

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div className="flex flex-col mb-[18px]">
                    <label className="text-[14px] mb-[6px] font-medium text-[#0f0f10]">
                      Full Name
                    </label>
                    <input
                      type="text"
                      placeholder="Enter your name"
                      required
                      className="p-3 rounded-lg border border-[#ddd] bg-white text-[14px] transition-all focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-blue-500/10"
                    />
                  </div>

                  <div className="flex flex-col mb-[18px]">
                    <label className="text-[14px] mb-[6px] font-medium text-[#0f0f10]">
                      Email Address
                    </label>
                    <input
                      type="email"
                      placeholder="Enter your email"
                      required
                      className="p-3 rounded-lg border border-[#ddd] bg-white text-[14px] transition-all focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-blue-500/10"
                    />
                  </div>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div className="flex flex-col mb-[18px]">
                    <label className="text-[14px] mb-[6px] font-medium text-[#0f0f10]">
                      Phone Number
                    </label>
                    <input
                      type="tel"
                      placeholder="Optional"
                      className="p-3 rounded-lg border border-[#ddd] bg-white text-[14px] transition-all focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-blue-500/10"
                    />
                  </div>

                  <div className="flex flex-col mb-[18px]">
                    <label className="text-[14px] mb-[6px] font-medium text-[#0f0f10]">
                      Service
                    </label>
                    <select className="p-3 rounded-lg border border-[#ddd] bg-white text-[14px] transition-all focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-blue-500/10">
                      <option>Select a service</option>
                      <option>Makeup Session</option>
                      <option>Bridal Makeup</option>
                      <option>Training</option>
                      <option>Consultation</option>
                    </select>
                  </div>
                </div>

                <div className="flex flex-col mb-[18px]">
                  <label className="text-[14px] mb-[6px] font-medium text-[#0f0f10]">
                    Your Message
                  </label>
                  <textarea
                    rows={8}
                    placeholder="Tell us what you need..."
                    className="p-3 rounded-lg border border-[#ddd] bg-white text-[14px] transition-all focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-blue-500/10 resize-none"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  className="w-full py-[14px] border-none rounded-lg bg-[#111827] text-white text-[15px] font-semibold cursor-pointer transition-colors duration-300 hover:bg-[#ff4d9e] hover:text-[#111827]"
                >
                  Send Message
                </button>
              </form>
            </div>
          </div>
        </section>
      </main>

      {/* ========================================================================= */}
      {/* 4. Footer */}
      {/* ========================================================================= */}
      <footer
        className="relative -top-32 text-center py-6 flex items-center justify-center"
        style={{
          background: 'linear-gradient(10deg, rgba(255,255,255,0.02), #ff4d9e)',
        }}
      >
        <div className="max-w-[1200px] mx-auto px-6">
          <div className="inline-flex flex-col sm:flex-row items-center gap-4 bg-gradient-to-br from-white/[0.08] to-white/[0.02] rounded-[18px] p-[22px] backdrop-blur-[8px] shadow-[0_8px_30px_rgba(0,0,0,0.25)] border border-white/10">
            <img
              src="/logo.jpg"
              alt="LoveDeGlam logo"
              className="w-14 h-14 rounded-[14px] object-cover border-2 border-white/20"
            />
            <small className="text-white text-sm font-medium">
              © {new Date().getFullYear()} LoveDeGlam — All rights reserved. Built with care.
            </small>
            <img
              src="/logo.jpg"
              alt="LoveDeGlam logo"
              className="w-14 h-14 rounded-[14px] object-cover border-2 border-white/20"
            />
          </div>
        </div>
      </footer>

      {/* Scroll to Top Button */}
      {showScrollTop && (
        <button
          onClick={scrollToTop}
          id="scrollTopBtn"
          title="Back to top"
          className="fixed bottom-[30px] right-[30px] z-[999] bg-gradient-to-r from-[#ff7ab6] to-[#ff4d9e] text-white border-none py-[14px] px-[18px] rounded-full cursor-pointer text-[18px] shadow-[0_4px_14px_rgba(0,0,0,0.3)] hover:-translate-y-1 hover:opacity-90 transition-all flex items-center justify-center"
        >
          ⬆
        </button>
      )}
    </div>
  );
}
