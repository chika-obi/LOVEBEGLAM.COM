@import "tailwindcss";

:root {
  --pink-1: #ff7ab6;
  --pink-2: #ff4d9e;
  --rose: #ff2e84;
  --dark: #0f0f10;
  --muted: #6b6b6b;
  --glass: rgba(255, 255, 255, 0.08);
  --glass-2: rgba(255, 255, 255, 0.12);
  --max-width: 1200px;
}

body {
  font-family: 'Montserrat', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: var(--dark);
  background: #fff;
  margin: 0;
  padding: 0;
}

/* Specific elements font matching exact site */
.nav-logo,
.logo h1,
h2.lead,
.font-playfair {
  font-family: 'Playfair Display', serif;
}

/* Header Hero Background */
header.hero {
  position: relative;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 480px;
  gap: 32px;
  align-items: center;
  overflow: hidden;
  padding-top: 80px;
}

header.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url('/background.jpg');
  background-size: cover;
  background-position: center;
  filter: brightness(0.55) saturate(1.05);
  z-index: 0;
  transform: scale(1.03);
}

.hero-inner {
  position: relative;
  z-index: 2;
  padding: 48px;
}

/* Logo */
.logo {
  display: flex;
  gap: 12px;
  align-items: center;
}

.logo img {
  width: 72px;
  height: 72px;
  border-radius: 14px;
  object-fit: cover;
  border: 2px solid rgba(255, 255, 255, 0.18);
}

.logo h1 {
  font-family: 'Playfair Display', serif;
  font-weight: 700;
  margin: 0;
  font-size: 22px;
  color: #fff;
  letter-spacing: 0.6px;
}

h2.lead {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  margin: 18px 0 8px;
  color: #fff;
  line-height: 1.05;
}

p.lead-desc {
  color: rgba(255, 255, 255, 0.92);
  margin: 0 0 20px;
}

.actions {
  display: flex;
  gap: 12px;
}

.btn {
  padding: 12px 18px;
  border-radius: 12px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  font-size: 15px;
  transition: all 0.3s;
}

.btn.primary {
  background: linear-gradient(90deg, var(--pink-1), var(--pink-2));
  color: #fff;
  box-shadow: 0 8px 30px rgba(255, 77, 158, 0.18);
}

.btn.primary:hover {
  filter: brightness(1.05);
  transform: translateY(-2px);
}

.btn.ghost {
  background: transparent;
  color: #fff;
  border: 1.5px solid rgba(255, 255, 255, 0.18);
}

.btn.ghost:hover {
  background: rgba(255, 255, 255, 0.1);
}

/* SVG decorative */
.waves {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 220px;
  z-index: 1;
  opacity: 0.75;
}

/* Glass card */
.card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
  border-radius: 18px;
  padding: 22px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Showcase */
.showcase {
  align-self: center;
  justify-self: end;
  position: relative;
  z-index: 2;
  margin-right: 48px;
}

.showcase .card {
  padding: 0;
  border-radius: 22px;
  overflow: hidden;
}

.showcase .hero-img {
  height: 480px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(0, 0, 0, 0.08));
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.showcase .hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@media (max-width: 980px) {
  header.hero {
    grid-template-columns: 1fr;
    min-height: 86vh;
    padding-bottom: 40px;
  }
  .showcase {
    order: -1;
    margin: 0;
  }
}

/* Canvas particle size */
canvas#glitter {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}


/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: #f1f1f1;
}
::-webkit-scrollbar-thumb {
  background: var(--pink-1);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--pink-2);
}
